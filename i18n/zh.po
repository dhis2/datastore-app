msgid "Code"
msgstr "代码"

msgid "Tree"
msgstr "树"

msgid "Text"
msgstr "文本"

msgid "The Code editor is a free-form JSON editor."
msgstr "“代码编辑器”是一款自由格式 JSON 编辑器。"

msgid "The Tree editor shows expandable nodes of the JSON object."
msgstr "“树”编辑器显示了 JSON 对象的可展开节点。"

msgid ""
"The Text editor allows you to add and edit non-JSON data, e.g. JSONata, "
"DataSonnet, or other mapping expressions, and stores it as a string."
msgstr "文本编辑器允许您添加和编辑非 JSON 数据（例如 JSONata、DataSonnet 或其他映射表达式），并将其存储为字符串。"

msgid "Invalid JSON detected. Fix the value in the Code Editor"
msgstr "检测到无效的 JSON。请在代码编辑器中修正该值"

msgid "An error has occurred"
msgstr "发生了错误"

msgid "404 Page Not Found"
msgstr "404 页面未找到"

msgid "Back to datastore"
msgstr "返回数据存储"

msgid "An error has occurred. Try again"
msgstr "发生错误。请重试"

msgid "Key"
msgstr "键值"

msgid "Namespace"
msgstr "命名空间"

msgid "Search"
msgstr "搜索"

msgid "Close"
msgstr "关闭"

msgid "Save"
msgstr "保存"

msgid "Save changes"
msgstr "保存修改"

msgid "New Key"
msgstr "新键"

msgid "Cancel"
msgstr "取消"

msgid "Add"
msgstr "添加"

msgid "Delete"
msgstr "删除"

msgid "Discard"
msgstr "放弃"

msgid "Do you want to discard the unsaved changes?"
msgstr "您要放弃未保存的更改吗？"

msgid "Namespaces"
msgstr "命名空间"

msgid "Choose a key to start editing"
msgstr "选择一个键开始编辑"

msgid "DataStore"
msgstr "DataStore"

msgid "UserDataStore"
msgstr "UserDataStore"

msgid "Key '{{key}}' updated successfully"
msgstr "键“{{key}} ”已成功更新"

msgid "There was a problem updating the key - {{error}}"
msgstr "更新密钥时出现了一个问题——{{error}}"

msgid "There was a problem - {{error}}"
msgstr "出现了一个问题——{{error}}"

msgid "There was a problem fetching this key's value. {{error}}"
msgstr "获取此键的值时出现问题。{{error}}"

msgid "There was a problem adding this key - {{error}}"
msgstr "添加此键时出现了一个问题——{{error}}"

msgid "Key '{{selectedKey}}' deleted successfully"
msgstr "键“{{selectedKey}} ”已成功删除"

msgid "There was a problem deleting this key - {{error}}"
msgstr "删除此键时出现了一个问题——{{error}}"

msgid "There was a problem fetching the keys in this namespace."
msgstr "在获取此命名空间中的密钥时出现了一个问题。"

msgid "Search keys"
msgstr "搜索关键词"

msgid "Add New Key"
msgstr "添加新密钥"

msgid "Delete Key"
msgstr "删除键"

msgid "This key has unsaved changes."
msgstr "该密钥有未保存的更改。"

msgid "There was a problem adding this namespace - {{error}}"
msgstr "添加此命名空间时出现了一个问题——{{error}}"

msgid "Namespace '{{namespace}}' deleted successfully"
msgstr "命名空间“{{namespace}} ”已成功删除"

msgid "There was a problem deleting this namespace - {{error}}"
msgstr "删除此命名空间时出现了一个问题——{{error}}"

msgid "Search namespaces"
msgstr "搜索命名空间"

msgid "New namespace"
msgstr "新命名空间"

msgid "Add New Namespace"
msgstr "添加新命名空间"

msgid "Delete Namespace"
msgstr "删除命名空间"

msgid "This will delete all the keys in this namespace"
msgstr "这将删除该命名空间中的所有键"

msgid "Actions"
msgstr "行动"

msgid "No items found"
msgstr "未找到任何项目"

msgid "There was a problem fetching this key's ID"
msgstr "获取此密钥的ID时出现问题"

msgid "Share"
msgstr "分享"
